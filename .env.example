# HACKMIND — WINNING IDEA ENGINE
# Configuration for multi-provider AI architecture (Groq, NVIDIA NIM, Ollama, OpenAI-compatible)
# Secrets must be kept strictly server-side.

# Groq API configuration (Free & Fast inference with Meta Llama models)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# NVIDIA NIM API configuration
NVIDIA_NIM_API_KEY="nvapi-your_nvidia_nim_key_here"

# Ollama local inference (No API key needed if local)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Custom OpenAI-Compatible endpoint (e.g. vLLM, OpenRouter, LM Studio)
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_MODEL=""

# Default selected provider: "groq" | "nvidia" | "ollama" | "custom" | "engine"
AI_DEFAULT_PROVIDER="groq"
AI_DEFAULT_MODEL="llama-3.3-70b-versatile"

# Server Port
PORT=3000
